 lge-battery-supplement {
  capacity-mah-min = <3400>;
  capacity-raw-full = <247>;

  default-battery-name = "LGE_BLT41_Tocad_3500mAh";
  default-battery-kohm = <91>;


  tempcomp-offset = <
   (-300) (-50)
   (-230) (-50)
   (-200) (-30)
   (-170) (-10)
   (-120) (-10)
   ( -60) (-20)
   ( -10) (-20)
      40 (-20)
      80 (-10)
     130 (-10)
     170 0
     220 0
     260 10
     310 10
     370 0
     420 0
     480 (-10)
     520 0
     570 0
     620 0
     660 10
     700 10
     730 50
     750 60
     800 120
  >;
  tempcomp-icoeff = <30>;
  LGE_BLT41_Tocad_3500mAh {
   tempcomp-icoeff = <30>;
   qcom,ki-coeff-low-chg = <200>;
   qcom,ki-coeff-med-chg = <200>;
   qcom,ki-coeff-hi-chg = <200>;
  };
  LGE_BLT41_LGC_3500mAh {
   qcom,ki-coeff-low-chg = <200>;
   qcom,ki-coeff-med-chg = <200>;
   qcom,ki-coeff-hi-chg = <200>;
  };
 };
};

&pm8150b_charger {
 lge,parallel-pct = <70>;
};

&pm8150b_vadc {
 bat_therm_pu1 {
  reg = <0x2a>;
  label = "bat_therm_pu1";
  qcom,pre-scaling = <1 1>;
 };

 bat_therm_pu2 {
  reg = <0x4a>;
  label = "bat_therm_pu2";
  qcom,pre-scaling = <1 1>;
 };

 bat_therm_pu3 {
  reg = <0x6a>;
  label = "bat_therm_pu3";
  qcom,pre-scaling = <1 1>;
 };
};

&qupv3_se0_i2c {
 idtp9222-charger@61 {

  idt,fod-bpp = [A5 28 88 2E 98 19 A3 03 A1 FB A8 E8];
  idt,fod-epp = [A4 31 88 44 86 46 96 19 97 0A 9C E7];
 };
};

&pm8150b_qnovo {
 lge,enable-compensate-qni-fcc;
};
# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-pm.dtsi" 2

&pm8150_gpios {
 interrupts = <0x0 0xc0 0 0>,
   <0x0 0xc2 0 0>,
   <0x0 0xc3 0 0>,
   <0x0 0xc5 0 0>,
   <0x0 0xc6 0 0>,
   <0x0 0xc8 0 0>,
   <0x0 0xc9 0 0>;
 interrupt-names = "pm8150_gpio1", "pm8150_gpio3",
   "pm8150_gpio4", "pm8150_gpio6",
   "pm8150_gpio7", "pm8150_gpio9",
   "pm8150_gpio10";
 qcom,gpios-disallowed = <2 5 8>;
};
# 26 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com.dtsi" 2
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-connectivity.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-connectivity.dtsi"
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-connectivity.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-connectivity.dtsi"
&vendor {
 bluetooth: bt_wcn3990 {
  compatible = "qca,wcn3990";
  qca,bt-vdd-core-supply = <&pm8150_l7>;
  qca,bt-vdd-pa-supply = <&pm8150l_l2>;
  qca,bt-vdd-ldo-supply = <&pm8150l_l11>;

  qca,bt-vdd-core-voltage-level = <1800000 1800000>;
  qca,bt-vdd-pa-voltage-level = <1304000 1304000>;
  qca,bt-vdd-ldo-voltage-level = <3312000 3312000>;

  qca,bt-vdd-core-current-level = <0>;
  qca,bt-vdd-pa-current-level = <0>;
  qca,bt-vdd-ldo-current-level = <0>;
 };
};
# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-connectivity.dtsi" 2
# 27 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com.dtsi" 2
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-nfc.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-nfc.dtsi"
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-nfc.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-nfc.dtsi"
&qupv3_se9_i2c {
 status = "ok";
 nq@28 {
  compatible = "qcom,nq-nci";
  reg = <0x28>;
  qcom,nq-irq = <&tlmm 47 0x00>;
  qcom,nq-ven = <&tlmm 41 0x00>;
  qcom,nq-firm = <&tlmm 48 0x00>;
  qcom,nq-clkreq = <&tlmm 113 0x00>;
  qcom,nq-esepwr = <&tlmm 42 0x00>;
  interrupt-parent = <&tlmm>;
  interrupts = <47 0>;
  interrupt-names = "nfc_irq";
  pinctrl-names = "nfc_active", "nfc_suspend";
  pinctrl-0 = <&nfc_int_active &nfc_enable_active
   &nfc_clk_req_active>;
  pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend
   &nfc_clk_req_suspend>;
 };
};
# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-nfc.dtsi" 2


&qupv3_se9_i2c {
 qcom,clk-freq-out = <1000000>;
 status = "ok";
 nq@28 {
  status = "disabled";
 };

 pn547@28 {
  compatible = "nxp,pn547";
  reg = <0x28>;
  status = "ok";
  nxp,gpio_sda = <&tlmm 39 0x00>;
  nxp,gpio_scl = <&tlmm 40 0x00>;
  nxp,gpio_ven = <&tlmm 41 0x00>;
  nxp,gpio_mode = <&tlmm 113 0x00>;
  nxp,gpio_irq = <&tlmm 47 0x00>;
  nxp,i2c-pull-up = <1>;
  qcom,clk-src = "BBCLK2";
  interrupt-parent = <&tlmm>;
  interrupts = <47 0>;
  interrupt-names = "nfc_irq";
 };
};
# 28 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com.dtsi" 2
