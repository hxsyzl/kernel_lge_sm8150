# 20 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com_hk_rev-b-overlay.dts" 2

/ {
 model = "LG Electronics, Alpha_lao_hk, rev_b";
 compatible = "qcom,sm8150-mtp", "qcom,sm8150", "qcom,mtp";
 qcom,board-id = <0x03070008 0>;
};

&soc{
 fingerprint@0 {
  goodix,vddio-supply = <&pm8150l_l7>;
  gf,vddio-uV = <3000000>;
 };
};

&usb_qmp_dp_phy {
 vdd-supply = <&pm8150_l18>;
 qcom,vdd-voltage-level = <0 912000 912000>;
};

&pm8150b_charger {
 lge-extension-usb {
  lge,usbid-parallel-kohm = <2000>;
 };
};

&lge_sbu_switch {
 lge,oe-gpio = <&tlmm 119 0>;

 pinctrl-0 = <&lge_sbu_switch_oe_active &lge_sbu_switch_sel_active>;
};

&tlmm {
 lge_sbu_switch_oe_active: lge_sbu_switch_oe_active {
  mux {
   pins = "gpio119";
   function = "gpio";
  };

  config {
   pins = "gpio119";
   drive-strength = <6>;
   bias-bus-hold;
  };
 };
};
