&tlmm {
 sec_mi2s_mclk {
  sec_mi2s_mclk_sleep: sec_mi2s_mclk_sleep {
   mux {
    pins = "gpio130";
    function = "gpio";
   };

   config {
    pins = "gpio130";
    drive-strength = <2>;
    bias-pull-down;
    input-enable;
   };
  };

  sec_mi2s_mclk_active: sec_mi2s_mclk_active {
   mux {
    pins = "gpio130";
    function = "sec_mi2s";
   };

   config {
    pins = "gpio130";
    drive-strength = <8>;
    bias-disable;
   };
  };
 };
};


