 qcom,mdss-dsi-bl-min-level = <1>;
 qcom,mdss-dsi-bl-max-level = <4095>;
 qcom,mdss-brightness-max-level = <365>;
 qcom,platform-te-gpio = <&tlmm 8 0>;
 qcom,platform-reset-gpio = <&tlmm 6 0>;
 lge,man-name = "LGD";
 lge,ddic-name = "sw43408a";
