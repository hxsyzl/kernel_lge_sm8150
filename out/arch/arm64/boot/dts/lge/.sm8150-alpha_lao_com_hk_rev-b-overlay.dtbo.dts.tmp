 io-channel-names = "charger_temp";
 status = "ok";
};

&pm8150b_vadc {
 vph_pwr {
  reg = <0x83>;
  label = "vph_pwr";
  qcom,pre-scaling = <1 3>;
 };

 vcoin {
  reg = <0x85>;
  label = "vcoin";
  qcom,pre-scaling = <1 3>;
 };

 conn_therm {
  reg = <0x4f>;
  label = "conn_therm";
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  qcom,pre-scaling = <1 1>;
 };

 chg_sbux {
  reg = <0x99>;
  label = "chg_sbux";
  qcom,pre-scaling = <1 3>;
 };

 mid_chg_div6 {
  reg = <0x1e>;
  label = "chg_mid";
  qcom,pre-scaling = <1 6>;
 };

 usb_in_i_uv {
  reg = <0x07>;
  label = "usb_in_i_uv";
  qcom,pre-scaling = <1 1>;
 };

 usb_in_v_div_16 {
  reg = <0x08>;
  label = "usb_in_v_div_16";
  qcom,pre-scaling = <1 16>;
 };

 bat_id {
  reg = <0x4b>;
  label = "bat_id";
  qcom,pre-scaling = <1 1>;
 };

};

