# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-panel.dtsi" 2

&sde_dsi {
 vddio-supply = <&pm8150_l14>;
 lab-supply = <&lcdb_ldo_vreg>;
 ibb-supply = <&lcdb_ncp_vreg>;
};

&sde_dp {
 pinctrl-names = "mdss_dp_active", "mdss_dp_sleep", "default";
 pinctrl-0 = <&sde_dp_aux_active &sde_dp_usbplug_cc_active>;
 pinctrl-1 = <&sde_dp_aux_suspend &sde_dp_usbplug_cc_suspend>;
 lge,dp-use;
};
# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-panel.dtsi" 2
# 24 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com.dtsi" 2
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-misc.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-misc.dtsi"
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-misc.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-misc.dtsi"
&soc {
 gpio_keys {
  compatible = "gpio-keys";
  label = "gpio-keys";

  pinctrl-names = "default";
  pinctrl-0 = <&key_vol_up_default>;

  vol_up {
   label = "volume_up";
   gpios = <&pm8150_gpios 6 1>;
   linux,input-type = <1>;
   linux,code = <115>;
   gpio-key,wakeup;
   debounce-interval = <15>;
   linux,can-disable;
  };

  hot1_key {
   label = "hot1_key";
   gpios = <&pm8150_gpios 1 1>;
   linux,input-type = <1>;
   linux,code = <377>;
   gpio-key,wakeup;
   debounce-interval = <15>;
   linux,can-disable;
  };
 };
};
