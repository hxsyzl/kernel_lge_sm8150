&ibat_lvl0 {
 temperature = <4000>;
};

&ibat_lvl1{
 temperature = <4800>;
};

&thermal_zones {
 gpuss-max-step {
  trips {
   gpu_trip0: gpu-trip0 {
    temperature = <85000>;
    hysteresis = <0>;
    type = "passive";
   };
  };
  cooling-maps {
   gpu_cdev {
    trip = <&gpu_trip0>;
    cooling-device =
     <&msm_gpu (~0)
                (((~0) - 1)-1)>;
   };
  };
 };

 apc-0-max-step {
  polling-delay-passive = <10>;
  polling-delay = <100>;
  trips {
   silver_trip: silver-trip {
    temperature = <85000>;
   };
  };
  cooling-maps {
   cluster_cdev0 {
    trip = <&silver_trip>;
    cooling-device =
     <&CPU0 (~0)
             (((~0) - 1)-1)>;
   };
   cluster_cdev1 {
    trip = <&silver_trip>;
    cooling-device =
     <&CPU1 (~0)
             (((~0) - 1)-1)>;
   };
   cluster_cdev2 {
    trip = <&silver_trip>;
    cooling-device =
     <&CPU2 (~0)
             (((~0) - 1)-1)>;
   };
   cluster_cdev3 {
    trip = <&silver_trip>;
    cooling-device =
     <&CPU3 (~0)
             (((~0) - 1)-1)>;
   };
  };
 };

 apc-1-max-step {
  polling-delay-passive = <10>;
  polling-delay = <100>;
  trips {
   gold_trip: gold-trip {
    temperature = <85000>;
   };
  };
  cooling-maps {
   cluster_cdev4 {
    trip = <&gold_trip>;
    cooling-device =
     <&CPU4 (~0)
             (((~0) - 1)-1)>;
   };
   cluster_cdev5 {
    trip = <&gold_trip>;
    cooling-device =
     <&CPU5 (~0)
             (((~0) - 1)-1)>;
   };
   cluster_cdev6 {
    trip = <&gold_trip>;
    cooling-device =
     <&CPU6 (~0)
             (((~0) - 1)-1)>;
   };
   cluster_cdev7 {
    trip = <&gold_trip>;
    cooling-device =
     <&CPU7 (~0)
             (((~0) - 1)-1)>;
   };
  };
 };

 pop-mem-step {
  trips {
   pop-trip {
    temperature = <85000>;
   };
  };
 };

 wp-therm {
  polling-delay-passive = <0>;
  polling-delay = <0>;
  thermal-governor = "user_space";
  thermal-sensors = <&pm8150b_adc_tm 0x4d>;
  trips {
   active-config0 {
    temperature = <125000>;
    hysteresis = <1000>;
    type = "passive";
   };
  };
 };

 xo-therm {
  polling-delay-passive = <0>;
  polling-delay = <0>;
  thermal-governor = "user_space";
  thermal-sensors = <&pm8150_adc_tm 0x4c>;
  trips {
   active-config0 {
    temperature = <125000>;
    hysteresis = <1000>;
    type = "passive";
   };
  };
 };

 skin-therm {
  polling-delay-passive = <0>;
  polling-delay = <0>;
  thermal-governor = "user_space";
  thermal-sensors = <&pm8150_adc_tm 0x4d>;
  trips {
   active-config0 {
    temperature = <125000>;
    hysteresis = <1000>;
    type = "passive";
   };
  };
 };

 pa-therm0 {
  polling-delay-passive = <0>;
  polling-delay = <0>;
