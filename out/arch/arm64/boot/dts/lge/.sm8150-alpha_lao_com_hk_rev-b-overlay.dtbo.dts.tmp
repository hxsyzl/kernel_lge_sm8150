    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 pmx_tdmb_ldo_en {
  tdmb_ldo_en_active: tdmb_ldo_en_active {
   mux {
    pins = "gpio166";
    function = "gpio";
   };
   config {
    pins = "gpio166";
    drive-strength = <2>;
    output-low;
    bias-disable;
   };
  };

  tdmb_ldo_en_suspend: tdmb_ldo_en_suspend {
