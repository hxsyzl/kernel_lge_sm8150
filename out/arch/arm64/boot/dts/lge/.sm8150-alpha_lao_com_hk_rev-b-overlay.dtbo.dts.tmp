# 30 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com.dtsi" 2
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-fingerprint.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-fingerprint.dtsi"
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-fingerprint.dtsi" 1
# 13 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-fingerprint.dtsi"
/{
 aliases {
  spi7 = &qupv3_se7_spi;
 };






};

&soc {






 qupv3_se7_spi: spi@89c000 {
  compatible = "qcom,spi-geni";
  #address-cells = <1>;
  #size-cells = <0>;
  reg = <0x89c000 0x4000>;
  reg-names = "se_phys";
  clock-names = "se-clk", "m-ahb", "s-ahb";
  clocks = <&clock_gcc 95>,
   <&clock_gcc 121>,
   <&clock_gcc 122>;
  pinctrl-names = "default", "sleep";
  pinctrl-0 = <&qupv3_se7_spi_active>;
  pinctrl-1 = <&qupv3_se7_spi_sleep>;
  interrupts = <0 608 0>;
  spi-max-frequency = <50000000>;
  status = "disable";
 };
};

&soc{
 fingerprint@0 {
  status = "ok";
      compatible = "goodix,fingerprint";

  interrupt-parent = <&tlmm>;
  interrupts = <118>;

  goodix,gpio_irq = <&tlmm 118 0x00>;
  goodix,gpio_reset = <&tlmm 116 0x00>;
  goodix,gpio_cs = <&tlmm 101 0x00>;
  pinctrl-names = "default";
  pinctrl-0 = <&gf_finger_id_default>;
 };

 qcom,qbt1000 {
  status = "disabled";
  compatible = "qcom,qbt1000";
  clock-names = "core", "iface";
  clock-frequency = <25000000>;
  qcom,ipc-gpio = <&tlmm 118 0>;
  pinctrl-names = "default";
  pinctrl-0 = <&key_home_default>;
  qcom,finger-detect-gpio = <&pm8150_gpios 1 0>;
 };
};

&tlmm {
 gf_finger_id_default: gf_finger_id_default {
  mux {
   pins = "gpio21";
   function = "gpio";
  };
  config {
   pins = "gpio21";
   drive-strength = <2>;
   bias-disable = <0>;
   input-enable;
  };
 };
};
# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-fingerprint.dtsi" 2
# 31 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com.dtsi" 2
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-usb.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-usb.dtsi"
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-usb.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-usb.dtsi"
&vendor {
 extcon_usb1: extcon_usb1 {
  compatible = "linux,extcon-usb-gpio";
  vbus-gpio = <&pm8150_gpios 10 0>;
  id-gpio = <&tlmm 101 0>;
  vbus-out-gpio = <&pm8150_gpios 9 0>;

  pinctrl-names = "default";
  pinctrl-0 = <&usb2_vbus_det_default
        &usb2_id_det_default
        &usb2_vbus_boost_default>;
 };
};

&usb0 {
 dwc3@a600000 {
  maximum-speed = "super-speed";
  usbpd = <&pm8150b_pdphy>;
 };
};

&usb1 {
 extcon = <&extcon_usb1>;
};

&pm8150b_pdphy {
 lge,sbu-sel-gpio = <&tlmm 87 0>;
 lge,uart-sbu-sel-gpio = <&tlmm 35 0>;
};




&vendor {
 lge_sbu_switch: lge_sbu_switch {
  compatible = "lge,lge_sbu_switch";

  lge,sel-gpio = <&tlmm 87 0>;
  lge,uart-sbu-sel-gpio = <&tlmm 35 0>;


  pinctrl-names = "default";
  pinctrl-0 = <&lge_sbu_switch_sel_active >;
 };
};

&tlmm {
 lge_sbu_switch_sel_active: lge_sbu_switch_sel_active {
  mux {
   pins = "gpio87";
   function = "gpio";
  };

  config {
   pins = "gpio87";
   bias-disable;
  };
 };
# 86 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-usb.dtsi"
};




&vendor {
 lge_usb_debugger: lge_usb_debugger {
  compatible = "lge,usb_debugger";
 };
};

&usb2_phy0 {
 qcom,hsusb-phy-tune = <0x61 0x43 0x2e 0x03>;
 qcom,hsusb-phy-tune-host = <0x61 0x43 0x2e 0x03>;
};
# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-usb.dtsi" 2
# 32 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com.dtsi" 2
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-storage.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-storage.dtsi"
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-storage.dtsi" 1
# 13 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-storage.dtsi"
# 1 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/../../sm8150_common/sm8150_common-storage.dtsi" 1
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/../../sm8150_common/sm8150_common-storage.dtsi"
&firmware {
 android {
  compatible = "android,firmware";
  fstab {
   compatible = "android,fstab";
   vendor {
    compatible = "android,vendor";
    dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
    type = "ext4";
    mnt_flags = "ro,barrier=1,discard";
    fsmgr_flags = "wait,slotselect,avb";
    status = "ok";
   };
   product {
    compatible = "android,product";
    dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/product";
    type = "ext4";
    mnt_flags = "ro,nodev,barrier=1,errors=continue";
    fsmgr_flags = "wait,slotselect,avb";
    status = "ok";
   };
   OP {
    compatible = "android,op";
    dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/OP";
    type = "ext4";
    mnt_point = "/product/OP";
    mnt_flags = "ro,noatime,nosuid,nodev,barrier=1,data=ordered,noauto_da_alloc";
    fsmgr_flags = "wait,slotselect,avb,nofail";
    status = "ok";
   };
   drm {
    compatible = "android,drm";
    dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/drm";
    type = "ext4";
    mnt_point = "/mnt/vendor/persist-lg";
    mnt_flags = "noatime,nosuid,nodev,barrier=1,data=ordered,noauto_da_alloc,errors=continue";
    fsmgr_flags = "wait,formattable";
    status = "ok";
   };
  };
 };
};
# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-storage.dtsi" 2

&ufsphy_mem {
 compatible = "qcom,ufs-phy-qmp-v4";

 vdda-phy-supply = <&pm8150_l5>;
 vdda-phy-always-on;
 vdda-pll-supply = <&pm8150l_l3>;
 vdda-phy-max-microamp = <90200>;
 vdda-pll-max-microamp = <19000>;

 status = "ok";
};

&ufshc_mem {
 vdd-hba-supply = <&ufs_phy_gdsc>;
 vdd-hba-fixed-regulator;
 vcc-supply = <&pm8150_l10>;
 vcc-voltage-level = <2504000 2950000>;
 vcc-low-voltage-sup;
 vccq-supply = <&pm8150_l9>;
 vccq2-supply = <&pm8150_s4>;
 vcc-max-microamp = <750000>;
 vccq-max-microamp = <700000>;
 vccq2-max-microamp = <750000>;

 qcom,vddp-ref-clk-supply = <&pm8150_l9>;
 qcom,vddp-ref-clk-max-microamp = <100>;

 status = "ok";
};

&sdhc_2 {
 vdd-supply = <&pm8150l_l9>;
 qcom,vdd-voltage-level = <2950000 2960000>;
 qcom,vdd-current-level = <200 800000>;

 vdd-io-supply = <&pm8150l_l6>;
 qcom,vdd-io-voltage-level = <1808000 2960000>;
 qcom,vdd-io-current-level = <200 22000>;

 pinctrl-names = "active", "sleep";
 pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &storage_cd>;
 pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &storage_cd>;

 cd-gpios = <&tlmm 96 0>;

 status = "ok";
};
