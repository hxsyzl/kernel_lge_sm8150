&qupv3_se4_i2c{
 es9218-codec@48{
  compatible = "dac,es9218-codec";
  status = "ok";
  reg = <0x48>;
  dac,use-internal-ldo;
  dac,power-gpio = <&pm8150_gpios 10 0x0>;
  dac,hph-sw = <&pm8150_gpios 9 0x0>;
  dac,reset-gpio = <&tlmm 24 0x0>;
 };
};

&pm8150_gpios {
 gpio@c900 {
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,vin-sel = <2>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,out-strength = <1>;
  qcom,master-en = <1>;
  status = "okay";
 };

 gpio@c800 {
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,vin-sel = <2>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,out-strength = <1>;
  qcom,master-en = <1>;
  status = "okay";
 };
};
