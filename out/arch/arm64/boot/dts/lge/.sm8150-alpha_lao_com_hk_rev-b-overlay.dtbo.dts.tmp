# 14 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/../sm8150-alpha_common/sm8150-alpha_common-pinctrl.dtsi"
&qupv3_se12_2uart {
 status = "ok";
};

&qupv3_se13_4uart {
 status = "ok";
};

&qupv3_se3_spi {
 status = "ok";
};

&qupv3_se4_i2c {
 status = "ok";
};

&tlmm {
 lge,access-denied-gpios = <92 93 94 95 98 99 100 101>;

 pmx_sde: pmx_sde {
  sde_dsi_active: sde_dsi_active {
   mux {
    pins = "gpio6";
    function = "gpio";
   };

   config {
    pins = "gpio6";
    drive-strength = <8>;
    bias-disable = <0>;
   };
  };

  sde_dsi_suspend: sde_dsi_suspend {
   mux {
    pins = "gpio6";
    function = "gpio";
   };

   config {
    pins = "gpio6";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 pmx_sde_te {
  sde_te_active: sde_te_active {
   mux {
    pins = "gpio8";
    function = "mdp_vsync";
   };

   config {
    pins = "gpio8";
    drive-strength = <2>;
    bias-pull-down;
   };
  };

  sde_te_suspend: sde_te_suspend {
   mux {
    pins = "gpio8";
    function = "mdp_vsync";
   };

   config {
    pins = "gpio8";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 sde_dp_aux_active:sde_dp_aux_active {
  mux {
   pins = "gpio42", "gpio148";
   function = "gpio";
  };

  config {
   pins = "gpio42", "gpio148";
   bias-disable = <0>;
   driver-strength = <8>;
  };
 };

 sde_dp_aux_suspend:sde_dp_aux_suspend {
  mux {
   pins = "gpio42", "gpio148";
   function = "gpio";
  };

  config {
   pins = "gpio42", "gpio148";
   bias-pull-down;
   driver-strength = <8>;
  };
 };

 pmx_ts_reset {
  ts_reset_active: ts_reset_active {
   mux {
    pins = "gpio54";
    function = "gpio";
   };
   config {
    pins = "gpio54";
    drive-strength = <6>;
    bias-pull-up;
   };
  };

  ts_reset_suspend: ts_reset_suspend {
   mux {
    pins = "gpio54";
    function = "gpio";
   };
   config {
    pins = "gpio54";
    drive-strength = <6>;
    bias-pull-down;
   };
  };
 };

 pmx_ts_int {
  ts_int_active: ts_int_active {
   mux {
    pins = "gpio122";
    function = "gpio";
   };
   config {
    pins = "gpio122";
    drive-strength = <2>;
    bias-pull-up;
   };
  };

  ts_int_suspend: ts_int_suspend {
   mux {
    pins = "gpio122";
    function = "gpio";
   };
   config {
    pins = "gpio122";
    drive-strength = <2>;
    bias-disable;
   };
  };
 };

 pmx_ts_vdd_en {
  ts_ftm4_vdd_en_active: ts_ftm4_vdd_en_active {
   mux {
    pins = "gpio59";
    function = "gpio";
   };
   config {
    pins = "gpio59";
    drive-strength = <2>;
    bias-pull-up;
   };
  };

  ts_ftm4_vdd_en_suspend: ts_ftm4_vdd_en_suspend {
   mux {
    pins = "gpio59";
    function = "gpio";
   };
   config {
    pins = "gpio59";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 pmx_ts_vio_en {
  ts_ftm4_vio_en_active: ts_ftm4_vio_en_active {
   mux {
    pins = "gpio152";
    function = "gpio";
   };
   config {
    pins = "gpio152";
    drive-strength = <2>;
    bias-pull-up;
   };
  };

  ts_ftm4_vio_en_suspend: ts_ftm4_vio_en_suspend {
   mux {
    pins = "gpio152";
    function = "gpio";
   };
   config {
    pins = "gpio152";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 atmf04_int_pin {
  atmf04_int_active: atmf04_int_active {
   mux {
    pins = "gpio37";
    function = "gpio";
   };
   config {
    pins = "gpio37";
    drive-strength = <6>;
    bias-pull-up;
   };
  };

  atmf04_int_suspend: atmf04_int_suspend {
   mux {
    pins = "gpio37";
    function = "gpio";
   };
   config {
    pins = "gpio37";
    drive-strength = <6>;
    bias-pull-up;
   };
  };
 };
};
# 15 "../arch/arm64/boot/dts/lge/sm8150-alpha/sm8150-alpha_lao_com/sm8150-alpha_lao_com-pinctrl.dtsi" 2

&tlmm {
 pmx_spi_tdmb {
  spi_tdmb_active: spi_tdmb_active {
   mux {
    pins = "gpio88", "gpio89", "gpio90", "gpio91";
    function = "qup8";
   };

   config {
    pins = "gpio88", "gpio89", "gpio90", "gpio91";
    drive-strength = <8>;
    bias-disable;
   };
  };

  spi_tdmb_suspend: spi_tdmb_suspend {
   mux {
    pins = "gpio88", "gpio89", "gpio90", "gpio91";
    function = "gpio";
   };

   config {
    pins = "gpio88", "gpio89", "gpio90", "gpio91";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 pmx_tdmb_int {
  tdmb_int_active: tdmb_int_active {
   mux {
    pins = "gpio108";
    function = "gpio";
   };
   config {
    pins = "gpio108";
    drive-strength = <2>;
    input-enable;
    bias-pull-up;
   };
  };
  tdmb_int_suspend: tdmb_int_suspend {
   mux {
    pins = "gpio108";
    function = "gpio";
   };
   config {
    pins = "gpio108";
    drive-strength = <2>;
    bias-pull-down;
   };
  };

 };

 pmx_tdmb_en_rev_a {
  tdmb_en_active_rev_a: tdmb_en_active_rev_a {
   mux {
    pins = "gpio166";
    function = "gpio";
   };
   config {
    pins = "gpio166";
    drive-strength = <4>;
    output-low;
    bias-disable;
   };
  };

  tdmb_en_suspend_rev_a: tdmb_en_suspend_rev_a {
   mux {
    pins = "gpio166";
    function = "gpio";
   };
   config {
    pins = "gpio166";
    drive-strength = <2>;
    bias-pull-down;
   };
  };

 };

 pmx_tdmb_en_rev_c {
  tdmb_en_active_rev_c: tdmb_en_active_rev_c {
   mux {
    pins = "gpio132";
    function = "gpio";
   };
   config {
    pins = "gpio132";
    drive-strength = <2>;
    output-low;
    bias-disable;
   };
  };

  tdmb_en_suspend_rev_c: tdmb_en_suspend_rev_c {
   mux {
    pins = "gpio132";
    function = "gpio";
   };
   config {
    pins = "gpio132";
    drive-strength = <2>;
    bias-pull-down;
   };
  };

 };

 pmx_tdmb_ant {
  tdmb_ant_active: tdmb_ant_active {
   mux {
    pins = "gpio163";
    function = "gpio";
   };
   config {
    pins = "gpio163";
    drive-strength = <2>;
    output-low;
    bias-disable;
   };
  };

  tdmb_ant_suspend: tdmb_ant_suspend {
   mux {
    pins = "gpio163";
    function = "gpio";
   };
   config {
    pins = "gpio163";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 pmx_tdmb_lna {
  tdmb_lna_active: tdmb_lna_active {
   mux {
    pins = "gpio11", "gpio164";
    function = "gpio";
   };
   config {
    pins = "gpio11", "gpio164";
    drive-strength = <2>;
    output-low;
    bias-disable;
   };
  };

  tdmb_lna_suspend: tdmb_lna_suspend {
   mux {
